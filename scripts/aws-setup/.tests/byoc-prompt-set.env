BASE_DOMAIN="byoc-aws.example.com"
REGION_NAME="byoc-aws-test"
DAYTONA_API_URL="https://app.daytona.io/api"
DAYTONA_API_KEY="dtn_test_only_not_real_AAAAAAAAAAAAAAAA"
CLUSTER_ISSUER_EMAIL="ops@example.com"
CLUSTER_NAME="byoc-aws-test"
AWS_REGION="us-east-1"
S3_BUCKET="byoc-aws-test-snapshots"
IAM_ACCESS_KEY="AKIATESTONLYNOTREAL00"
IAM_SECRET_KEY="abcdEFGH1234567890testonlynotrealAAAAAAA"
RUNNER_AWS_CREDENTIAL_MODE="static"
IRSA_ROLE_ARN=""
INTERNAL_REGISTRY_HOST=""
PROXY_WILDCARD_TLS="false"
