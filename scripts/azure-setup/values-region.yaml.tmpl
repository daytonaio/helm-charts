# daytona-region (BYOC) helm values - Azure / AKS, K8s-native flow.
# Rendered by scripts/azure-setup/up.sh via envsubst against operator prompts.
#
# Required ${VAR} placeholders (set by up.sh from prompts or computed):
#   BASE_DOMAIN                  - public DNS base, e.g. byoc.example.com
#   REGION_NAME                  - Daytona region name
#   DAYTONA_API_URL              - Daytona Cloud API URL
#   DAYTONA_API_KEY              - Daytona Cloud admin API key (secret)
#   AZURE_REGION                 - Azure region, e.g. eastus
#   BLOB_BUCKET                  - Azure Blob container name (runner backup storage)
#   RCLONE_GATEWAY_ENDPOINT      - in-cluster S3 facade for Azure Blob, e.g. http://rclone-s3-gateway.daytona:8080
#   RCLONE_ACCESS_KEY            - rclone gateway access key (matches the gateway Secret)
#   RCLONE_SECRET_KEY            - rclone gateway secret key (matches the gateway Secret)
#   RUNNER_AWS_CREDENTIAL_MODE   - "static" (Azure Workload Identity wiring is future work)
#   AZURE_CLIENT_ID              - Azure WI client ID (currently unused; placeholder for future work)
#   RUNNER_IMAGE_TAG             - daytona-runner image tag
#   INTERNAL_REGISTRY_HOST       - optional cluster-DNS hostname for an internal Docker registry (empty = none)
#   PRIV_CLIENT_B64              - base64 of the gateway->sandbox client PRIVATE key file
#   PUB_CLIENT_B64               - base64 of the matching client PUBLIC key file
#   PRIV_GATEWAY_B64             - base64 of the gateway HOST key file
#
# IMPORTANT (Azure-specific): Azure Blob is NOT natively S3-compatible. The
# RUNNERS talk to an in-cluster `rclone-s3-gateway` deployment that proxies
# their S3 backup/build-context calls to Azure Blob (up.sh applies
# rclone-deployment.yaml.tmpl BEFORE helm install). The SNAPSHOT-MANAGER does
# NOT use the gateway: its registry s3 driver (distribution v3) resumes blob
# uploads via ListMultipartUploads and nil-panics on the stub responses S3
# shims return, so it runs on the chart's filesystem driver (PVC) instead —
# snapshots are rebuildable, disk persistence is the sound trade.

baseDomain: "${BASE_DOMAIN}"
regionName: "${REGION_NAME}"
proxyUrl: "https://proxy.${BASE_DOMAIN}"
snapshotManagerUrl: "https://snapshots.${BASE_DOMAIN}"
daytonaApiUrl: "${DAYTONA_API_URL}"
daytonaApiKey: "${DAYTONA_API_KEY}"

global:
  storageClass: "managed-csi"

registration:
  enabled: true

services:
  # BYOC stale-runner reaper (see docs/operations.md).
  # REQUIRES an org API key with read/write/delete:runners scopes + the
  # organization_infrastructure feature flag enabled for your Daytona org.
  runnerReaper:
    enabled: true
  proxy:
    ingress:
      enabled: true
      className: "nginx"
      tls: true
      # wildcardTls=true requires a DNS-01 issuer; default false issues a
      # non-wildcard proxy cert that succeeds under HTTP-01. Set by up.sh
      # (true only when CLOUDFLARE_API_TOKEN is provided for DNS-01).
      wildcardTls: ${PROXY_WILDCARD_TLS}
      selfSigned: false
      annotations:
        cert-manager.io/cluster-issuer: "letsencrypt-prod"
        nginx.ingress.kubernetes.io/ssl-redirect: "true"
        # Sandboxes hold long-running websocket and interactive sessions.
        nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
        nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
        # Build contexts and uploads exceed nginx's 1m default body limit.
        nginx.ingress.kubernetes.io/proxy-body-size: "0"
        nginx.ingress.kubernetes.io/proxy-request-buffering: "off"

  sshGateway:
    enabled: true
    # BOOTSTRAP value only: the gateway validates SSH sessions against the
    # Daytona API and the org key 403s on ValidateSshAccess. up.sh swaps in the
    # REGION-SCOPED key right after install (omc::region_sshgateway_finalize) —
    # that key cannot exist before the registration hook creates the region.
    apiKey: "${DAYTONA_API_KEY}"
    sshKeys:
      privClientSSHKey: "${PRIV_CLIENT_B64}"
      pubClientSSHKey: "${PUB_CLIENT_B64}"
      privGatewaySSHKey: "${PRIV_GATEWAY_B64}"

  snapshotManager:
    enabled: true
    logLevel: "info"
    ingress:
      enabled: true
      className: "nginx"
      hostname: "snapshots.${BASE_DOMAIN}"
      tls: true
      annotations:
        cert-manager.io/cluster-issuer: "letsencrypt-prod"
        nginx.ingress.kubernetes.io/ssl-redirect: "true"
        # Docker layer pushes exceed nginx's 1m default body limit (413).
        nginx.ingress.kubernetes.io/proxy-body-size: "0"
        nginx.ingress.kubernetes.io/proxy-read-timeout: "900"
        nginx.ingress.kubernetes.io/proxy-send-timeout: "900"
    storage:
      # Registry data on a PVC — see the header for why the rclone S3 shim
      # cannot back the registry (multipart-resume nil-panic).
      driver: "filesystem"
      filesystem:
        persistence:
          enabled: true
          size: 64Gi
      deleteEnabled: true

  runner:
    image:
      tag: "${RUNNER_IMAGE_TAG}"
    # The runner-manager owns the real (cloud-registered) runner pods; they
    # envFrom runner-config/runner-secrets and bind hostPorts 3000/2220. A
    # static mainContainer runner never registers with Daytona Cloud and
    # would fight the manager's pods for those hostPorts — keep the
    # DaemonSet sidecar-only (host prep: docker + daemon binaries).
    mainContainer:
      enabled: false
    ports:
      api: 3000
      ssh: 2220
    hostPaths:
      varLibDaytona: /var/lib/daytona
    aws:
      credentialMode: "${RUNNER_AWS_CREDENTIAL_MODE}"
      allowEmptyStaticKeyShim: false
    serviceAccount:
      create: true
      annotations:
        # Azure Workload Identity placeholder (future work). Currently empty.
        azure.workload.identity/client-id: "${AZURE_CLIENT_ID}"
      automountServiceAccountToken: true
    env:
      # Runner backups/build context go through the rclone gateway to Azure
      # Blob (plain PUT/GET — unlike the registry, this path is shim-safe).
      AWS_REGION: "us-east-1"
      AWS_ENDPOINT_URL: "${RCLONE_GATEWAY_ENDPOINT}"
      AWS_DEFAULT_BUCKET: "${BLOB_BUCKET}"
      AWS_ACCESS_KEY_ID: "${RCLONE_ACCESS_KEY}"
      AWS_SECRET_ACCESS_KEY: "${RCLONE_SECRET_KEY}"
      # Must be the base64 of the SAME client pubkey the gateway holds, or
      # sandboxes refuse gateway SSH connections (silent SSH-only failure).
      SSH_PUBLIC_KEY: "${PUB_CLIENT_B64}"
    dockerInstaller:
      dynamicHostAliases: []
      insecureRegistries: []
